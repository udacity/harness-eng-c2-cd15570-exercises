{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "deny",
      "npm *": "allow",
      "npm run lint:*": "allow",
      "npm run test:*": "allow",
      "rm *": "deny",
      "grep *": "allow",
      "ruff *": "allow"
    },
    "edit": {
      "*": "allow",
      "*.md": "allow"
    },
    "read": {
      "*": "allow"
    },
    "external_directory": {
      "~/projects/personal/**": "allow"
    }
  },
  "agent": {
    "read-only-evaluator": {
      "description": "Read-only code evaluator for I2.6 comparison testing",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "read": "allow",
        "webfetch": "allow",
        "grep": "allow",
        "glob": "allow"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if echo \"$OPENCODE_TOOL_INPUT\" | grep -qE \"rm -rf|git push.*--force|:(){ :|:& };\"; then echo \"BLOCKED: Dangerous command detected\" && exit 2; fi'"
          }
        ]
      },
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if echo \"$OPENCODE_TOOL_INPUT\" | grep -qE \"git commit\"; then FILES=$(git diff --cached --name-only 2>/dev/null || echo \"\"); for f in $FILES; do if [ -f \"$f\" ] && grep -qiE \"(api[_-]?key|secret|password|token)[\\s:=\\\"]+[\\w\\-_]{16,}\" \"$f\" 2>/dev/null; then echo \"BLOCKED: Potential secret detected in $f\" && exit 2; fi; done; fi'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ruff check --fix $OPENCODE_FILE_PATHS 2>/dev/null || true'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"$(date -Iseconds) OpenCode session completed\" >> ~/.hermes/cache/scratch/opencode-hook-activity.log'"
          }
        ]
      }
    ]
  },
  "description": "OpenCode pre-built hooks replicating I2.2 enforcement using native config"
}
